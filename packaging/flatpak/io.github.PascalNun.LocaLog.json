{
  "app-id": "io.github.PascalNun.LocaLog",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "localog",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--socket=pulseaudio",
    "--share=network",
    "--env=GTK_USE_PORTAL=1"
  ],
  "modules": [
    {
      "name": "localog",
      "buildsystem": "simple",
      "build-commands": [
        "ar x localog.deb",
        "mkdir deb",
        "tar -xf data.tar.* -C deb",
        "install -Dm755 deb/usr/bin/localog /app/bin/localog",
        "for tool in record-meeting whisper llama-server speaker-diarization speaker-embedding ffmpeg ffprobe; do install -Dm755 deb/usr/bin/localog-$tool /app/bin/localog-$tool; done",
        "mkdir -p /app/lib; if test -d deb/usr/lib; then cp -a deb/usr/lib/. /app/lib/; fi",
        "install -Dm644 io.github.PascalNun.LocaLog.desktop /app/share/applications/io.github.PascalNun.LocaLog.desktop",
        "install -Dm644 io.github.PascalNun.LocaLog.metainfo.xml /app/share/metainfo/io.github.PascalNun.LocaLog.metainfo.xml",
        "install -Dm644 localog.png /app/share/icons/hicolor/128x128/apps/io.github.PascalNun.LocaLog.png"
      ],
      "sources": [
        { "type": "file", "path": "localog.deb" },
        { "type": "file", "path": "io.github.PascalNun.LocaLog.desktop" },
        { "type": "file", "path": "io.github.PascalNun.LocaLog.metainfo.xml" },
        { "type": "file", "path": "localog.png" }
      ]
    }
  ]
}
