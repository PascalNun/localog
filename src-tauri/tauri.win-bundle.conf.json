{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "externalBin": [
      "binaries/localog-record-meeting",
      "binaries/localog-whisper",
      "binaries/localog-llama-server",
      "binaries/localog-speaker-diarization",
      "binaries/localog-speaker-embedding",
      "binaries/localog-ffmpeg",
      "binaries/localog-ffprobe"
    ],
    "resources": ["binaries/licences/*"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "LocaLog",
        "languages": [
          "English",
          "German",
          "French",
          "Spanish",
          "Italian",
          "Japanese",
          "Korean",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
